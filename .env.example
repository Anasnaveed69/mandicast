# Copy to .env (never commit .env). docker compose reads it automatically.

# Images. CD writes IMAGE_TAG on the server; `docker compose up --build` ignores these locally.
REGISTRY=ghcr.io/anasnaveed69
IMAGE_TAG=latest

# Secrets: change these (deploy/ec2-setup.sh generates random values).
ADMIN_TOKEN=change-me
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# Serving. MODEL_SOURCE=mlflow loads @champion from the registry,
# MODEL_SOURCE=local loads the bundle in models/serving (python -m mandicast.export).
MODEL_SOURCE=mlflow
MODEL_ALIAS=champion
HTTP_PORT=80
API_MEMORY_LIMIT=1500m

# Data and artifacts on AWS. Leave DVC_REMOTE_URL empty to keep everything on the server.
# Example: DVC_REMOTE_URL=s3://mandicast-dvc/mandicast
#          MLFLOW_ARTIFACTS_DESTINATION=s3://mandicast-dvc/mlflow
DVC_REMOTE_URL=
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts
AWS_DEFAULT_REGION=ap-south-1
# Not needed on EC2 when the instance has an IAM role with access to the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Scheduler: daily AMIS scrape time (Asia/Karachi). RETRAIN_WEEKDAY (e.g. sun) also
# retrains from the server; leave empty when GitHub Actions triggers retraining.
REFRESH_AT=18:30
RETRAIN_WEEKDAY=
